# Optional overrides (defaults work out of the box)
# Read by the Next.js server AND by scripts/mdns.mjs + network-check.mjs
# (plain node does not load .env by itself — scripts/load-env.mjs does it).
# Copy this file to .env and uncomment what you need, then restart the server.
# Production LAN port is 80 (no :port in the URL). Dev uses 3000.
# OPENSEND_DB=./data/opensend.db
# OPENSEND_STORAGE=./storage

# Local-network identity (centralized - do not hard-code the IP elsewhere).
# Server listens on 0.0.0.0; these values only name the preferred address/hostname.
# OPEN_SEND_HOST=192.168.1.118
# OPEN_SEND_HOSTNAME=btec-send.local
# OPENSEND_HOST_IP is accepted as an alias of OPEN_SEND_HOST (used by scripts/mdns.mjs).
